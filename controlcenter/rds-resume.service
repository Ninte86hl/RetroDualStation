# RetroDualStation – Power-Menü nach dem Aufwachen schließen
# Wird vom Installer nach /storage/.config/system.d/ kopiert und
# in suspend/hibernate/hybrid-sleep.target.wants verlinkt.

[Unit]
Description=RetroDualStation – Power-Menü nach Resume schließen
After=suspend.target hibernate.target hybrid-sleep.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'kill -USR1 $(pgrep -f rds_cc.py) 2>/dev/null || true'

[Install]
WantedBy=suspend.target hibernate.target hybrid-sleep.target
