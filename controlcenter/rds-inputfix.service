# RetroDualStation – Korrekturen für InputPlumber (Home-Taste, Phantom-Stick RG DS Plus, Stick-Kalibrierung).
# Läuft vor InputPlumber; ohne InputPlumber (ROCKNIX vor 10/2026) tut er nichts.
[Unit]
Description=RetroDualStation – InputPlumber-Korrekturen
DefaultDependencies=no
After=local-fs.target systemd-udev-trigger.service
Before=inputplumber.service
ConditionPathExists=/usr/bin/inputplumber

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/python3 /storage/.config/retrodualstation/controlcenter/rds_inputfix.py an

[Install]
WantedBy=inputplumber.service
