# RetroDualStation Kontrollcenter – läuft zusammen mit EmulationStation.
#
# Wichtig: das Kontrollcenter startet Sway NICHT selbst (kein Requires=sway.service).
# Es hängt sich an essway: startet erst, wenn ES läuft (Sway ist dann fertig eingerichtet),
# und wird mit ES zusammen beendet bzw. neu gestartet.
[Unit]
Description=RetroDualStation Kontrollcenter
After=essway.service
PartOf=essway.service
# Nur im Dual-Modus (Drop-in von es-switch-helper.sh); im Single-Modus ruht das CC, ROCKNIX übernimmt
ConditionPathExists=|/storage/.config/system.d/essway.service.d/rds-dual.conf
ConditionPathExists=|/storage/.config/system.d/essway.service.d/rgds.conf

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=/var/run/0-runtime-dir
Environment=WAYLAND_DISPLAY=wayland-1
Environment=HOME=/storage
ExecStartPre=/bin/sleep 2
ExecStart=/usr/bin/python3 /storage/.config/retrodualstation/controlcenter/rds_cc.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=essway.service
