<?xml version="1.0" encoding="UTF-8" ?>
<!--
    ROCKNIX DualStation – canvas-ds game list views (RG DS Plus, 2048 x 768).
    Top screen X 0 - 0.5, bottom screen X 0.5 - 1.0.
    Replaces the original game list layouts of canvas-ds:

      Gamelist view style      View
      Detailed                 List    : only the game names, centred
      Automatic / Carousel     Icons   : 3 square icons like the system view (thumbnail)
      Spotlight                Spotlight: horizontal carousel of cards, 2:3 cover (boxart) + logo (marquee)
      Showcase                 Showcase: vertical cover carousel (boxart), description, info

    "Automatic" = "Carousel" (theme root: defaultView="gamecarousel").
    The Grid view of canvas-ds is not offered any more.
    Top screen in all views: hero artwork (image), video fades in after 5 s.
    Media tags as written by RocknixDS Artwork Manager:
      Hero -> image   (romname-hero.png)
      Icon -> cartridge (romname-icon.png)
      Grid -> boxart  (romname-box.png)
      Logo -> marquee (romname-logo.png)
    The migration script and the Artwork Manager point <thumbnail> to the
    icon as well, so the carousel (thumbnail) shows the icons; scraped games
    show their box. Showcase uses boxart, then cartridge, thumbnail, image.
-->
<theme>
	<formatVersion>7</formatVersion>

	<!-- ===================================================== All game list views -->
	<view name="detailed, gamecarousel">
		<!-- Hide the original canvas-ds game details and panels -->
		<image name="md_marquee,md_thumbnail,md_image">
			<visible>false</visible>
		</image>
		<image name="playtime-logo,game-metadata-background-shadow-base,game-metadata-background-image-base,game-metadata-background-shadow-extended,game-metadata-background-image-extended,game-list-background-shadow,game-list-background,game-list-background-desc" extra="true">
			<visible>false</visible>
		</image>
		<datetime name="md_releasedate,md_lastplayed">
			<visible>false</visible>
		</datetime>
		<text name="md_name,md_players,md_genre,md_developer,md_publisher,md_playcount,md_gametime_custom,md_description">
			<visible>false</visible>
		</text>
		<rating name="md_rating">
			<visible>false</visible>
		</rating>

		<!-- Top screen: hero artwork, video after 5 seconds -->
		<video name="md_video">
			<pos>0.25 0.44</pos><!-- centred at the height of the icon row -->
			<origin>0.5 0.5</origin>
			<maxSize>0.44 0.6</maxSize>
			<delay>5</delay>
			<showSnapshotNoVideo>true</showSnapshotNoVideo>
			<showSnapshotDelay>true</showSnapshotDelay>
			<snapshotSource>image</snapshotSource>
			<effect>fade</effect>
			<roundCorners ifSubset="font-size:medium|large">${CornersLarge}</roundCorners>
			<roundCorners ifSubset="font-size:small">${CornersMedium}</roundCorners>
			<visible>true</visible>
			<zIndex>8</zIndex>
		</video>
	</view>

	<!-- ===================================================== List (Detailed) -->
	<view name="detailed">
		<textlist name="gamelist">
			<origin>0.5 0.5</origin>
			<pos>0.75 0.48</pos>
			<size>0.42 0.84</size>
			<alignment>center</alignment>
			<horizontalMargin>0.01</horizontalMargin>
			<zIndex>12</zIndex>
		</textlist>
	</view>

	<!-- ===================================================== Carousel: 3 icons (also "Automatic") -->
	<!-- Built without itemTemplate, so the custom views Spotlight and Showcase can
	     inherit from it without taking over the icon styling.
	     imageSource thumbnail: the migration/Artwork Manager points thumbnail
	     to the icon (romname-icon.png), scraped games show their box instead. -->
	<view name="gamecarousel">
		<gamecarousel name="gamecarousel">
			<type>horizontal</type>
			<origin>0 0.5</origin>
			<pos>0.5 0.44</pos>
			<size>0.5 1</size>
			<logoSize>0.255 0.345</logoSize><!-- relative to the carousel: 261 x 265 px -->
			<logoScale>1.3</logoScale><!-- selected: 339 x 344 px -->
			<maxLogoCount>3</maxLogoCount>
			<scaledLogoSpacing>${logospacing}</scaledLogoSpacing>
			<logoRotation>0</logoRotation>
			<logoAlignment>center</logoAlignment>
			<minLogoOpacity>0.9</minLogoOpacity>
			<imageSource>thumbnail</imageSource>
			<color>00000000</color>
			<linearSmooth>true</linearSmooth>
			<zIndex>50</zIndex>
		</gamecarousel>
		<image name="gamecarouselLogo">
			<roundCorners ifSubset="font-size:medium|large">${CornersLarge}</roundCorners>
			<roundCorners ifSubset="font-size:small">${CornersMedium}</roundCorners>
		</image>
		<text name="gamecarouselLogoText">
			<color>${systemInfoColor}</color>
		</text>
		<!-- Name of the selected game below the icons -->
		<text name="md_name">
			<origin>0.5 0.5</origin>
			<pos>0.75 0.72</pos>
			<size>0.46 0.06</size>
			<alignment>center</alignment>
			<fontPath>${fontBold}</fontPath>
			<fontSize>${systemYearFontSize}</fontSize>
			<color>${systemInfoColor}</color>
			<autoScroll>horizontal</autoScroll>
			<visible>true</visible>
			<zIndex>20</zIndex>
		</text>
	</view>

	<!-- ===================================================== Spotlight (grid + logo) -->
	<!-- Horizontal carousel like the system view: each game is one card with
	     the 2:3 cover on the left and its logo on the right. The selected card
	     is in the middle, the neighbours slide in from the sides. -->
	<customView name="spotlight" displayName="Spotlight" inherits="gamecarousel">
		<gamecarousel name="gamecarousel">
			<type>horizontal</type>
			<origin>0 0.5</origin>
			<pos>0.5 0.44</pos>
			<size>0.5 1</size>
			<!-- In custom views ES takes logoSize relative to the whole screen
			     (2048 x 768): 0.2246 x 0.365 = 460 x 280 px per card -->
			<logoSize>0.2246 0.365</logoSize>
			<logoScale>1.2</logoScale><!-- selected card: 552 x 336 px -->
			<maxLogoCount>2</maxLogoCount><!-- one card in the middle, half of the neighbours at the sides -->
			<scaledLogoSpacing>0</scaledLogoSpacing>
			<logoRotation>0</logoRotation>
			<logoAlignment>center</logoAlignment>
			<minLogoOpacity>0.5</minLogoOpacity>
			<imageSource>boxart</imageSource>
			<color>00000000</color>
			<linearSmooth>true</linearSmooth>
			<zIndex>50</zIndex>
			<itemTemplate>
				<storyboard event="activate">
					<animation property="scale" to="1.03" duration="150" mode="easeOut" />
				</storyboard>
				<storyboard event="deactivate">
					<animation property="scale" to="1" duration="250" mode="easeOut" />
				</storyboard>
				<!-- Cover (2:3) on the left -->
				<image name="spotCover" extra="true">
					<path>firstfile({game:boxart}, {game:cartridge}, {game:thumbnail}, {game:image})</path>
					<origin>0 0.5</origin>
					<pos>0.02 0.5</pos>
					<maxSize>0.4 0.98</maxSize>
					<roundCorners>${CornersMedium}</roundCorners>
					<linearSmooth>true</linearSmooth>
					<zIndex>3</zIndex>
				</image>
				<!-- Logo on the right -->
				<image name="spotLogo" extra="true">
					<path>{game:marquee}</path>
					<origin>0.5 0.5</origin>
					<pos>0.72 0.5</pos>
					<maxSize>0.54 0.62</maxSize>
					<linearSmooth>true</linearSmooth>
					<zIndex>4</zIndex>
				</image>
				<!-- Name instead of the logo when there is none -->
				<text name="spotName" extra="true">
					<text>{game:name}</text>
					<origin>0.5 0.5</origin>
					<pos>0.72 0.5</pos>
					<size>0.54 0.5</size>
					<alignment>center</alignment>
					<fontPath>${fontBold}</fontPath>
					<fontSize>0.035</fontSize>
					<color>${systemInfoColor}</color>
					<visible>!exists({game:marquee})</visible>
					<zIndex>4</zIndex>
				</text>
			</itemTemplate>
		</gamecarousel>
		<image name="gamecarouselLogo">
			<roundCorners>0</roundCorners>
		</image>
		<text name="md_name">
			<visible>false</visible>
		</text>
	</customView>

	<!-- ===================================================== Showcase -->
	<customView name="coverdetails" displayName="Showcase" inherits="gamecarousel">
		<!-- Vertical cover carousel on the left of the bottom screen;
		     previous and next cover peek in at the top and bottom -->
		<gamecarousel name="gamecarousel">
			<type>vertical</type>
			<!-- Centre at y 0.37 = middle of the description (0.14 - 0.60).
			     Size 1.26 so the carousel still reaches the bottom edge. -->
			<origin>0 0.5</origin>
			<pos>0.51 0.37</pos>
			<size>0.17 1.26</size>
			<logoSize>0.08 0.32</logoSize><!-- screen-relative: 164 x 246 px, selected 213 x 320 px -->
			<maxLogoCount>3</maxLogoCount><!-- previous cover peeks in at the top, next one below -->
			<logoScale>1.3</logoScale>
			<scaledLogoSpacing>0</scaledLogoSpacing>
			<logoRotation>0</logoRotation>
			<logoAlignment>center</logoAlignment>
			<minLogoOpacity>0.45</minLogoOpacity>
			<imageSource>boxart</imageSource>
			<color>ffffff00</color>
			<linearSmooth>true</linearSmooth>
			<zIndex>50</zIndex>
			<itemTemplate>
				<image name="gameArt" extra="true">
					<path>firstfile({game:boxart}, {game:cartridge}, {game:thumbnail}, {game:image})</path>
					<pos>0.5 0.5</pos>
					<origin>0.5 0.5</origin>
					<maxSize>1 1</maxSize>
					<roundCorners>${CornersMedium}</roundCorners>
					<linearSmooth>true</linearSmooth>
					<zIndex>3</zIndex>
				</image>
			</itemTemplate>
		</gamecarousel>

		<!-- Right side: title, description, info -->
		<text name="md_name">
			<origin>0 0.5</origin>
			<pos>0.70 0.08</pos>
			<size>0.28 0.07</size>
			<alignment>left</alignment>
			<fontPath>${fontBold}</fontPath>
			<fontSize>0.04</fontSize>
			<color>${systemInfoColor}</color>
			<autoScroll>horizontal</autoScroll>
			<visible>true</visible>
			<zIndex>20</zIndex>
		</text>
		<text name="md_description">
			<origin>0 0</origin>
			<pos>0.70 0.14</pos>
			<size>0.28 0.46</size>
			<alignment>left</alignment>
			<fontPath>${fontRegular}</fontPath>
			<fontSize>0.03</fontSize>
			<lineSpacing>1.3</lineSpacing>
			<color>${gameMetadataColor}</color>
			<autoScroll>vertical</autoScroll>
			<autoScrollDelay>4000</autoScrollDelay>
			<autoScrollSpeed>60</autoScrollSpeed>
			<visible>true</visible>
			<zIndex>20</zIndex>
		</text>

		<text name="label_players" extra="true">
			<text>Players</text>
			<origin>0 0.5</origin>
			<pos>0.70 0.70</pos>
			<size>0.13 0.06</size>
			<fontPath>${fontBold}</fontPath>
			<fontSize>0.03</fontSize>
			<color>${gameMetadataColor}</color>
			<opacity>0.6</opacity>
			<zIndex>20</zIndex>
		</text>
		<text name="md_players">
			<origin>1 0.5</origin>
			<pos>0.98 0.70</pos>
			<size>0.15 0.06</size>
			<alignment>right</alignment>
			<fontPath>${fontBold}</fontPath>
			<fontSize>0.03</fontSize>
			<color>${systemInfoColor}</color>
			<value>-</value>
			<visible>true</visible>
			<zIndex>20</zIndex>
		</text>

		<text name="label_released" extra="true">
			<text>Released</text>
			<origin>0 0.5</origin>
			<pos>0.70 0.77</pos>
			<size>0.13 0.06</size>
			<fontPath>${fontBold}</fontPath>
			<fontSize>0.03</fontSize>
			<color>${gameMetadataColor}</color>
			<opacity>0.6</opacity>
			<zIndex>20</zIndex>
		</text>
		<datetime name="md_releasedate">
			<origin>1 0.5</origin>
			<pos>0.98 0.77</pos>
			<size>0.15 0.06</size>
			<alignment>right</alignment>
			<format>%Y</format>
			<fontPath>${fontBold}</fontPath>
			<fontSize>0.03</fontSize>
			<color>${systemInfoColor}</color>
			<value>-</value>
			<visible>true</visible>
			<zIndex>20</zIndex>
		</datetime>

		<text name="label_developer" extra="true">
			<text>Developer</text>
			<origin>0 0.5</origin>
			<pos>0.70 0.84</pos>
			<size>0.13 0.06</size>
			<fontPath>${fontBold}</fontPath>
			<fontSize>0.03</fontSize>
			<color>${gameMetadataColor}</color>
			<opacity>0.6</opacity>
			<zIndex>20</zIndex>
		</text>
		<text name="md_developer">
			<origin>1 0.5</origin>
			<pos>0.98 0.84</pos>
			<size>0.16 0.06</size>
			<alignment>right</alignment>
			<fontPath>${fontBold}</fontPath>
			<fontSize>0.03</fontSize>
			<color>${systemInfoColor}</color>
			<autoScroll>horizontal</autoScroll>
			<value>-</value>
			<visible>true</visible>
			<zIndex>20</zIndex>
		</text>
	</customView>
</theme>
