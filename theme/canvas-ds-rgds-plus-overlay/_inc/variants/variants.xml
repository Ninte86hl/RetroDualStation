<?xml version="1.0" encoding="UTF-8" ?>
<!--
    ROCKNIX DualStation – canvas-ds game list variants (RG DS Plus, 2048 x 768).
    Top screen X 0 - 0.5, bottom screen X 0.5 - 1.0.
    Replaces the original game list layouts of canvas-ds:

      Gamelist view style      Variant
      Automatic / List         VI  game list only, centred names (no other artwork)
      Detailed                 original canvas-ds list with game info
                               (marquee hidden, larger description)
      Grid                     V   Grid   : 2:3 covers (boxart), 5 x 2
      Carousel                 IV  Logos  : vertical logo carousel (marquee)
      Icons (3)                I   3 square icons (thumbnail)
      Icons (5)                II  5 square icons (thumbnail)
      Details                  III vertical cover carousel (boxart), description, info

    Top screen in all variants: hero artwork (image), video fades in after 5 s.
    Media tags as written by RocknixDS Artwork Manager:
      Hero -> image, Icon -> thumbnail, Grid -> boxart, Logo -> marquee
-->
<theme>
	<formatVersion>7</formatVersion>

	<!-- ===================================================== Carousel and grid views -->
	<view name="gamecarousel, grid">
		<!-- Hide the original canvas-ds game details and panels -->
		<image name="md_marquee,md_thumbnail,md_image">
			<visible>false</visible>
		</image>
		<image name="playtime-logo,game-metadata-background-shadow-base,game-metadata-background-image-base,game-metadata-background-shadow-extended,game-metadata-background-image-extended,game-list-background-shadow,game-list-background,game-list-background-desc" extra="true">
			<visible>false</visible>
		</image>
		<datetime name="md_releasedate,md_lastplayed">
			<visible>false</visible>
		</datetime>
		<text name="md_name,md_players,md_genre,md_developer,md_publisher,md_playcount,md_gametime_custom,md_description">
			<visible>false</visible>
		</text>
		<rating name="md_rating">
			<visible>false</visible>
		</rating>

	</view>

	<!-- ===================================================== All game list views -->
	<view name="detailed, gamecarousel, grid">
		<!-- Top screen: hero artwork, video after 5 seconds -->
		<video name="md_video">
			<pos>0.25 0.44</pos><!-- centred at the height of the icon row -->
			<origin>0.5 0.5</origin>
			<maxSize>0.44 0.6</maxSize>
			<delay>5</delay>
			<showSnapshotNoVideo>true</showSnapshotNoVideo>
			<showSnapshotDelay>true</showSnapshotDelay>
			<snapshotSource>image</snapshotSource>
			<effect>fade</effect>
			<roundCorners ifSubset="font-size:medium|large">${CornersLarge}</roundCorners>
			<roundCorners ifSubset="font-size:small">${CornersMedium}</roundCorners>
			<visible>true</visible>
			<zIndex>8</zIndex>
		</video>
	</view>

	<!-- ===================================================== Detailed (original canvas-ds list) -->
	<!-- Marquee hidden; cover smaller, description panel taller.
	     Right edge 0.975 = same margin as the info bars below and the list on the left. -->
	<view name="detailed">
		<image name="md_marquee">
			<visible>false</visible>
		</image>
		<image name="md_thumbnail">
			<origin>0.5 0</origin>
			<pos>0.8705 0.07</pos>
			<maxSize>0.195 0.29</maxSize>
		</image>
		<image name="game-list-background-desc" extra="true">
			<origin>0.5 0</origin>
			<pos>0.8705 0.39</pos>
			<size>0.209 0.38</size>
		</image>
		<text name="md_description">
			<origin>0.5 0</origin>
			<pos>0.8705 0.405</pos>
			<size>0.193 0.35</size>
		</text>
	</view>

	<!-- ===================================================== V Grid (2:3 covers) -->
	<view name="grid">
		<imagegrid name="gamegrid">
			<pos>0.51 0.06</pos>
			<size>0.48 0.76</size>
			<autoLayout>5 2</autoLayout>
			<cellProportion>0.6666667</cellProportion>
			<imageSource>boxart</imageSource>
			<margin>0.012</margin>
			<autoLayoutSelectedZoom>1.06</autoLayoutSelectedZoom>
		</imagegrid>
		<text name="md_name">
			<origin>0.5 0.5</origin>
			<pos>0.75 0.9</pos>
			<size>0.46 0.06</size>
			<alignment>center</alignment>
			<fontPath>${fontBold}</fontPath>
			<fontSize>0.035</fontSize>
			<color>${systemInfoColor}</color>
			<visible>true</visible>
			<zIndex>20</zIndex>
		</text>
	</view>

	<!-- ===================================================== IV Logos (Carousel) -->
	<view name="gamecarousel">
		<gamecarousel name="gamecarousel">
			<type>vertical</type>
			<origin>0.5 0.5</origin>
			<pos>0.75 0.5</pos>
			<size>0.5 1</size>
			<logoSize>0.425 0.165</logoSize><!-- 435 x 127 px -->
			<logoScale>1.35</logoScale><!-- selected: 587 x 171 px -->
			<maxLogoCount>5</maxLogoCount>
			<logoRotation>0</logoRotation>
			<logoAlignment>center</logoAlignment>
			<minLogoOpacity>0.35</minLogoOpacity>
			<imageSource>marquee</imageSource>
			<color>00000000</color>
			<linearSmooth>true</linearSmooth>
			<zIndex>50</zIndex>
		</gamecarousel>
	</view>

	<!-- ===================================================== I Icons (3) -->
	<customView name="icons3" displayName="Icons (3)" inherits="gamecarousel">
		<gamecarousel name="gamecarousel">
			<type>horizontal</type>
			<origin>0 0.5</origin>
			<pos>0.5 0.48</pos>
			<size>0.5 1</size>
			<!-- In custom views ES takes logoSize relative to the whole screen
			     (2048 x 768), not to the carousel: 0.17 x 0.46 = 348 x 353 px -->
			<logoSize>0.17 0.46</logoSize>
			<maxLogoCount>3</maxLogoCount>
			<logoScale>1.3</logoScale>
			<scaledLogoSpacing>${logospacing}</scaledLogoSpacing>
			<logoRotation>0</logoRotation>
			<logoAlignment>center</logoAlignment>
			<minLogoOpacity>0.9</minLogoOpacity>
			<imageSource>thumbnail</imageSource>
			<color>ffffff00</color>
			<linearSmooth>true</linearSmooth>
			<zIndex>50</zIndex>
			<itemTemplate>
				<storyboard event="activate">
					<animation property="scale" to="1.05" duration="150" mode="easeOut" />
				</storyboard>
				<storyboard event="deactivate">
					<animation property="scale" to="1" duration="250" mode="easeOut" />
				</storyboard>
				<image name="shade" extra="true">
					<path>${themePath}/_inc/system-view/square-bg.png</path>
					<pos>0.5 0.82</pos>
					<origin>0.5 1</origin>
					<maxSize>0.84 0.84</maxSize>
					<roundCorners ifSubset="font-size:medium|large">${CornersLarge}</roundCorners>
					<roundCorners ifSubset="font-size:small">${CornersMedium}</roundCorners>
					<zIndex>2</zIndex>
				</image>
				<image name="gameArt" extra="true">
					<path>firstfile({game:thumbnail}, {game:boxart}, {game:image})</path>
					<pos>0.5 0.78</pos>
					<origin>0.5 1</origin>
					<maxSize>0.75 0.75</maxSize>
					<roundCorners ifSubset="font-size:medium|large">${CornersLarge}</roundCorners>
					<roundCorners ifSubset="font-size:small">${CornersMedium}</roundCorners>
					<linearSmooth>true</linearSmooth>
					<zIndex>3</zIndex>
				</image>
				<text name="gameName" extra="true">
					<text>{game:name}</text>
					<origin>0.5 0</origin>
					<pos>0.5 0.81</pos>
					<size>1 0.12</size>
					<alignment>center</alignment>
					<fontPath>${fontBold}</fontPath>
					<fontSize>${systemYearFontSize}</fontSize>
					<color>${systemInfoColor}</color>
					<zIndex>5</zIndex>
					<opacity>0.25</opacity>
					<storyboard event="activate">
						<animation property="opacity" to="1.00" duration="150" mode="easeOut" />
					</storyboard>
					<storyboard event="deactivate">
						<animation property="opacity" to="0.25" duration="150" mode="easeOut" />
					</storyboard>
				</text>
			</itemTemplate>
		</gamecarousel>
	</customView>

	<!-- ===================================================== II Icons (5) -->
	<customView name="icons5" displayName="Icons (5)" inherits="gamecarousel">
		<gamecarousel name="gamecarousel">
			<type>horizontal</type>
			<origin>0.5 0.5</origin>
			<pos>0.75 0.47</pos>
			<size>0.5 0.5</size>
			<logoSize>0.095 0.25</logoSize><!-- screen-relative: 195 x 192 px -->
			<maxLogoCount>5</maxLogoCount>
			<logoScale>1.3</logoScale>
			<scaledLogoSpacing>0</scaledLogoSpacing>
			<logoRotation>0</logoRotation>
			<logoAlignment>center</logoAlignment>
			<minLogoOpacity>0.9</minLogoOpacity>
			<imageSource>thumbnail</imageSource>
			<color>ffffff00</color>
			<linearSmooth>true</linearSmooth>
			<zIndex>50</zIndex>
			<itemTemplate>
				<storyboard event="activate">
					<animation property="scale" to="1.05" duration="150" mode="easeOut" />
				</storyboard>
				<storyboard event="deactivate">
					<animation property="scale" to="1" duration="250" mode="easeOut" />
				</storyboard>
				<image name="shade" extra="true">
					<path>${themePath}/_inc/system-view/square-bg.png</path>
					<pos>0.5 0.82</pos>
					<origin>0.5 1</origin>
					<maxSize>0.84 0.84</maxSize>
					<roundCorners ifSubset="font-size:medium|large">${CornersLarge}</roundCorners>
					<roundCorners ifSubset="font-size:small">${CornersMedium}</roundCorners>
					<zIndex>2</zIndex>
				</image>
				<image name="gameArt" extra="true">
					<path>firstfile({game:thumbnail}, {game:boxart}, {game:image})</path>
					<pos>0.5 0.78</pos>
					<origin>0.5 1</origin>
					<maxSize>0.75 0.75</maxSize>
					<roundCorners ifSubset="font-size:medium|large">${CornersLarge}</roundCorners>
					<roundCorners ifSubset="font-size:small">${CornersMedium}</roundCorners>
					<linearSmooth>true</linearSmooth>
					<zIndex>3</zIndex>
				</image>
				<text name="gameName" extra="true">
					<text>{game:name}</text>
					<origin>0.5 0</origin>
					<pos>0.5 0.81</pos>
					<size>1 0.12</size>
					<alignment>center</alignment>
					<fontPath>${fontBold}</fontPath>
					<fontSize>0.03</fontSize>
					<color>${systemInfoColor}</color>
					<zIndex>5</zIndex>
					<opacity>0</opacity>
					<storyboard event="activate">
						<animation property="opacity" to="1.00" duration="150" mode="easeOut" />
					</storyboard>
					<storyboard event="deactivate">
						<animation property="opacity" to="0" duration="150" mode="easeOut" />
					</storyboard>
				</text>
			</itemTemplate>
		</gamecarousel>
	</customView>

	<!-- ===================================================== III Details -->
	<customView name="coverdetails" displayName="Details" inherits="gamecarousel">
		<!-- Vertical cover carousel on the left of the bottom screen;
		     previous and next cover peek in at the top and bottom -->
		<gamecarousel name="gamecarousel">
			<type>vertical</type>
			<!-- Centre at y 0.37 = middle of the description (0.14 - 0.60).
			     Size 1.26 so the carousel still reaches the bottom edge. -->
			<origin>0 0.5</origin>
			<pos>0.51 0.37</pos>
			<size>0.17 1.26</size>
			<logoSize>0.08 0.32</logoSize><!-- screen-relative: 164 x 246 px, selected 213 x 320 px -->
			<maxLogoCount>3</maxLogoCount><!-- previous cover peeks in at the top, next one below -->
			<logoScale>1.3</logoScale>
			<scaledLogoSpacing>0</scaledLogoSpacing>
			<logoRotation>0</logoRotation>
			<logoAlignment>center</logoAlignment>
			<minLogoOpacity>0.45</minLogoOpacity>
			<imageSource>boxart</imageSource>
			<color>ffffff00</color>
			<linearSmooth>true</linearSmooth>
			<zIndex>50</zIndex>
			<itemTemplate>
				<image name="gameArt" extra="true">
					<path>firstfile({game:boxart}, {game:thumbnail}, {game:image})</path>
					<pos>0.5 0.5</pos>
					<origin>0.5 0.5</origin>
					<maxSize>1 1</maxSize>
					<roundCorners>${CornersMedium}</roundCorners>
					<linearSmooth>true</linearSmooth>
					<zIndex>3</zIndex>
				</image>
			</itemTemplate>
		</gamecarousel>

		<!-- Right side: title, description, info -->
		<text name="md_name">
			<origin>0 0.5</origin>
			<pos>0.70 0.08</pos>
			<size>0.28 0.07</size>
			<alignment>left</alignment>
			<fontPath>${fontBold}</fontPath>
			<fontSize>0.04</fontSize>
			<color>${systemInfoColor}</color>
			<autoScroll>horizontal</autoScroll>
			<visible>true</visible>
			<zIndex>20</zIndex>
		</text>
		<text name="md_description">
			<origin>0 0</origin>
			<pos>0.70 0.14</pos>
			<size>0.28 0.46</size>
			<alignment>left</alignment>
			<fontPath>${fontRegular}</fontPath>
			<fontSize>0.03</fontSize>
			<lineSpacing>1.3</lineSpacing>
			<color>${gameMetadataColor}</color>
			<autoScroll>vertical</autoScroll>
			<autoScrollDelay>4000</autoScrollDelay>
			<autoScrollSpeed>60</autoScrollSpeed>
			<visible>true</visible>
			<zIndex>20</zIndex>
		</text>

		<text name="label_players" extra="true">
			<text>Players</text>
			<origin>0 0.5</origin>
			<pos>0.70 0.70</pos>
			<size>0.13 0.06</size>
			<fontPath>${fontBold}</fontPath>
			<fontSize>0.03</fontSize>
			<color>${gameMetadataColor}</color>
			<opacity>0.6</opacity>
			<zIndex>20</zIndex>
		</text>
		<text name="md_players">
			<origin>1 0.5</origin>
			<pos>0.98 0.70</pos>
			<size>0.15 0.06</size>
			<alignment>right</alignment>
			<fontPath>${fontBold}</fontPath>
			<fontSize>0.03</fontSize>
			<color>${systemInfoColor}</color>
			<value>-</value>
			<visible>true</visible>
			<zIndex>20</zIndex>
		</text>

		<text name="label_released" extra="true">
			<text>Released</text>
			<origin>0 0.5</origin>
			<pos>0.70 0.77</pos>
			<size>0.13 0.06</size>
			<fontPath>${fontBold}</fontPath>
			<fontSize>0.03</fontSize>
			<color>${gameMetadataColor}</color>
			<opacity>0.6</opacity>
			<zIndex>20</zIndex>
		</text>
		<datetime name="md_releasedate">
			<origin>1 0.5</origin>
			<pos>0.98 0.77</pos>
			<size>0.15 0.06</size>
			<alignment>right</alignment>
			<format>%Y</format>
			<fontPath>${fontBold}</fontPath>
			<fontSize>0.03</fontSize>
			<color>${systemInfoColor}</color>
			<value>-</value>
			<visible>true</visible>
			<zIndex>20</zIndex>
		</datetime>

		<text name="label_developer" extra="true">
			<text>Developer</text>
			<origin>0 0.5</origin>
			<pos>0.70 0.84</pos>
			<size>0.13 0.06</size>
			<fontPath>${fontBold}</fontPath>
			<fontSize>0.03</fontSize>
			<color>${gameMetadataColor}</color>
			<opacity>0.6</opacity>
			<zIndex>20</zIndex>
		</text>
		<text name="md_developer">
			<origin>1 0.5</origin>
			<pos>0.98 0.84</pos>
			<size>0.16 0.06</size>
			<alignment>right</alignment>
			<fontPath>${fontBold}</fontPath>
			<fontSize>0.03</fontSize>
			<color>${systemInfoColor}</color>
			<autoScroll>horizontal</autoScroll>
			<value>-</value>
			<visible>true</visible>
			<zIndex>20</zIndex>
		</text>
	</customView>

	<!-- ===================================================== VI List (default for "Automatic") -->
	<!-- Only the game names, centred on the bottom screen; hero on the top screen.
	     Theme root: defaultView="list". -->
	<customView name="list" displayName="List" inherits="detailed">
		<image name="md_marquee,md_thumbnail,md_image">
			<visible>false</visible>
		</image>
		<image name="playtime-logo,game-metadata-background-shadow-base,game-metadata-background-image-base,game-metadata-background-shadow-extended,game-metadata-background-image-extended,game-list-background-shadow,game-list-background,game-list-background-desc" extra="true">
			<visible>false</visible>
		</image>
		<datetime name="md_releasedate,md_lastplayed">
			<visible>false</visible>
		</datetime>
		<text name="md_name,md_players,md_genre,md_developer,md_publisher,md_playcount,md_gametime_custom,md_description">
			<visible>false</visible>
		</text>
		<rating name="md_rating">
			<visible>false</visible>
		</rating>
		<textlist name="gamelist">
			<origin>0.5 0.5</origin>
			<pos>0.75 0.48</pos>
			<size>0.42 0.84</size>
			<alignment>center</alignment>
			<horizontalMargin>0.01</horizontalMargin>
			<zIndex>12</zIndex>
		</textlist>
	</customView>
</theme>
