+void MenuComponent::render(const Transform4x4f& parentTrans)
+{
+	// RDS: Rahmen und Schatten des Menüs dürfen nicht auf den anderen Bildschirm ragen
+	// (fiel bei Vollbild-Menüs auf kleinen Bildschirmen auf, z. B. RG DS 640x480).
+	if (!RdsScreens::active())
+	{
+		GuiComponent::render(parentTrans);
+		return;
+	}
+	const auto& m = RdsScreens::menu();
+	Renderer::pushClipRect((int)m.x, (int)m.y, (int)m.w, (int)m.h);
+	GuiComponent::render(parentTrans);
+	Renderer::popClipRect();
+}
