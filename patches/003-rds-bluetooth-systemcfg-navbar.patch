+static long long rdsMtime(const std::string& f)
+{
+	struct stat st;
+	if (f.empty() || stat(f.c_str(), &st) != 0) return 0;
+	return (long long)st.st_mtime * 1000000000LL + st.st_mtim.tv_nsec;
+}
 
