 }
 
+void SystemConf::reloadIfChanged()
+{
+	if (mSystemConfFile.empty() || !changedConf.empty())
+		return;
+	long long m = rdsMtime(mSystemConfFile);
+	if (m != 0 && m != mSystemConfMtime)
+	{
+		LOG(LogInfo) << "RDS: system.cfg changed externally, reloading";
+		loadSystemConf();
+	}
+}
