diff --git a/es-core/src/RdsScreens.h b/es-core/src/RdsScreens.h
new file mode 100644
index 000000000..808e5aa0d
--- /dev/null
+++ b/es-core/src/RdsScreens.h
@@ -0,0 +1,80 @@
+#pragma once
+// RetroDualStation: Bildschirm-Bereiche im gemeinsamen ES-Fenster.
+// Quelle: /storage/.config/retrodualstation/screens.cfg
+//   top=x,y,w,h
+//   bottom=x,y,w,h
+//   menu=top|bottom      (Menüs, Meldungen; der andere Bereich bekommt die Tastatur)
+// Ohne Datei: Fenster 2048x768 -> zwei Hälften (oben links, unten rechts),
+// sonst ein Bildschirm = ganzes Fenster (Verhalten wie Original-ES).
+#include "renderers/Renderer.h"
+#include <fstream>
+#include <string>
+#include <cstdio>
+
+namespace RdsScreens
+{
+	struct Rect { float x = 0, y = 0, w = 0, h = 0; };
+
+	struct Layout
+	{
+		bool dual = false;
+		Rect top, bottom;
+		bool menuOnTop = true;
+		int forW = -1, forH = -1;
+	};
+
+	inline Layout& layout()
+	{
+		static Layout l;
+		int sw = Renderer::getScreenWidth(), sh = Renderer::getScreenHeight();
+		if (l.forW == sw && l.forH == sh)
+			return l;
+
+		l = Layout();
+		l.forW = sw; l.forH = sh;
+		Rect full; full.w = (float)sw; full.h = (float)sh;
+		l.top = full; l.bottom = full;
+
+		bool haveTop = false, haveBottom = false;
+		std::ifstream f("/storage/.config/retrodualstation/screens.cfg");
+		std::string line;
+		while (f && std::getline(f, line))
+		{
+			if (line.empty() || line[0] == '#')
+				continue;
+			auto eq = line.find('=');
+			if (eq == std::string::npos)
+				continue;
+			std::string key = line.substr(0, eq), val = line.substr(eq + 1);
+			Rect r;
+			if ((key == "top" || key == "bottom") && sscanf(val.c_str(), "%f,%f,%f,%f", &r.x, &r.y, &r.w, &r.h) == 4 && r.w > 0 && r.h > 0)
+			{
+				if (key == "top") { l.top = r; haveTop = true; }
+				else { l.bottom = r; haveBottom = true; }
+			}
+			else if (key == "menu")
+				l.menuOnTop = val.find("bottom") != 0;
+		}
+
+		if (haveTop && haveBottom)
+			l.dual = true;
+		else if (sw == 2048 && sh == 768)
+		{
+			l.dual = true;
+			l.top = { 0, 0, 1024, 768 };
+			l.bottom = { 1024, 0, 1024, 768 };
+		}
+		return l;
+	}
+
+	inline bool active() { return layout().dual; }
+	inline const Rect& top() { return layout().top; }
+	inline const Rect& bottom() { return layout().bottom; }
+	inline const Rect& menu() { return layout().menuOnTop ? layout().top : layout().bottom; }
+	inline const Rect& other() { return layout().menuOnTop ? layout().bottom : layout().top; }
+
+	inline float menuX() { return menu().x; }
+	inline float menuW() { return menu().w; }
+	inline float otherX() { return active() ? other().x : 0.0f; }
+	inline float otherW() { return other().w; }
+}
