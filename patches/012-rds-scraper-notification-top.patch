@@ -1152,6 +1152,23 @@ void Window::renderAsyncNotifications(const Transform4x4f& trans)
 
 #define PADDING_H  (Renderer::getScreenWidth()*0.01)
 
+	// RDS: im Dual-Modus unten mittig auf dem oberen Bildschirm, übereinander nach oben gestapelt –
+	// oben in der Mitte sitzen die Meldungen des Kontrollcenters (Lautstärke, Akku, Erfolge)
+	if (RdsScreens::active())
+	{
+		const auto& top = RdsScreens::top();
+		float y = top.y + top.h * 0.97f;
+		for (auto child : mAsyncNotificationComponent)
+		{
+			auto sz = child->getSize();
+			y -= sz.y();
+			child->setPosition(top.x + (top.w - sz.x()) / 2.0f, y, 0);
+			child->render(trans);
+			y -= top.h * 0.015f;
+		}
+		return;
+	}
+
 	float posY = Renderer::getScreenHeight() * 0.02f;
 
 	bool first = true;
